# Copy to .env for local work: cp .env.example .env
# Real values for staging and production live in GitHub Actions secrets and on the server,
# never in this repository, email or chat (QA plan 6.2).

# local | ci | staging | production. The dev login stub works only when APP_ENV=local.
APP_ENV=local

# MySQL (docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=greenhouse
DB_USER=greenhouse
DB_PASSWORD=greenhouse_dev_only
DB_ROOT_PASSWORD=root_dev_only

# Front end: where the browser finds the API
VITE_API_URL=http://localhost:8000

# SIUE single sign-on settings are added with ADR 0003 (D3).
