# C++ static analysis (QA plan 3.1): bugprone, modernize and readability checks, no warnings allowed,
# and no raw new or delete (cppcoreguidelines-owning-memory).
Checks: >
  -*,
  bugprone-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-owning-memory,
  -modernize-use-trailing-return-type,
  -readability-identifier-length
WarningsAsErrors: "*"
HeaderFilterRegex: "cpp/(include|src)/.*"
